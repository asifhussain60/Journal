# Temporary working files
scratchpad-*.txt

# OS files
.DS_Store
**/.DS_Store
Thumbs.db

# Claude Code (per-machine local state)
.claude/

# MCP config (contains API tokens)
.mcp.json

# Editor files
*.swp
*.swo
*~

# Python virtual environment
.venv/

# Node packages
node_modules/

# Environment files (API keys should live in macOS Keychain, not .env)
.env
.env.local
*.env
!*.template.env

# Python bytecode
**/__pycache__/
*.pyc

# Trash / soft-delete staging
**/.trash/

# Per-trip queue + ephemeral artifacts (App writes, Cowork drains and deletes per §5.10)
trips/*/pending.json
trips/*/receipts/
trips/*/photos/
trips/*/voice-inbox/
trips/*/voice-inbox.json
trips/*/itinerary-inbox.json
trips/*/snapshots/

# VSCode workspace favorites (user-local IDE state)
.favorites.json

# Retired Express proxy debris (2026-05-22 retirement; API now lives in worker/).
# Guard against a stray respawner reintroducing crash logs into the tree.
server/

# Cloudflare Worker local dev + build artifacts
.dev.vars
.wrangler/
site/dist/
site/node_modules/

# Legacy front-end kept on-disk for reference-porting during the rebuild
# (all of it also lives in git history on develop); removed at Phase 8.
site/_legacy/

# TypeScript incremental build cache
*.tsbuildinfo

# Generated at build from manifest.authored.json + chapter-status.md
site/src/content/manifest.generated.json
# Chapter mirror (regenerated by build-manifest.mjs from canonical content/)
site/public/chapters/
