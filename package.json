{
  "name": "journal",
  "version": "1.0.0",
  "description": "Babu memoir engine + Vite/React/Tailwind journal site on a Cloudflare Worker.",
  "private": true,
  "type": "module",
  "scripts": {
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "worker:dev": "wrangler dev",
    "worker:typecheck": "tsc -p worker/tsconfig.json",
    "deploy": "bash infra/deploy.sh"
  },
  "keywords": ["journal", "memoir"],
  "author": "Asif Hussain",
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "wrangler": "^3.99.0"
  }
}
